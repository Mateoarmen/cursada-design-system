{
  "name": "cursada-design-system",
  "version": "1.0.0",
  "private": true,
  "description": "Cursada — gestión académica personal, entregable HTML/CSS/JS autónomo generado desde el handoff de Claude Design.",
  "type": "module",
  "scripts": {
    "build:app": "node build/build-app.mjs",
    "build:landing": "node build/build-landing.mjs",
    "build:legal": "node build/build-legal.mjs",
    "build:static": "node build/build-static.mjs",
    "build:test": "node build/build-test.mjs",
    "build": "npm run build:app && npm run build:landing && npm run build:legal && npm run build:static",
    "test:sim": "node --test test/simulador.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-list": "^3.31.4",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/extensions": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "dompurify": "^3.4.16",
    "esbuild": "^0.25.12"
  }
}
